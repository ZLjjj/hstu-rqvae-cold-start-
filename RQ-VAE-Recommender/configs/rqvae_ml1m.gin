import data.processed

train.iterations=50000
train.learning_rate=0.0001
train.weight_decay=0.01
train.batch_size=2048
train.amp=True
train.mixed_precision_type="bf16"
train.vae_input_dim=402
train.vae_n_cat_feats=18
train.vae_hidden_dims=[512, 256, 128]
train.vae_embed_dim=64
train.vae_codebook_size=1024
train.vae_codebook_normalize=True
train.vae_sim_vq=False
train.save_model_every=10000
train.eval_every=5000
train.dataset_folder="dataset/ml-1m"
train.dataset=%data.processed.RecDataset.ML_1M
train.save_dir_root="out/rqvae/ml1m/"
train.csv_log_path="out/rqvae/ml1m/metrics.csv"
train.export_bridge_path="out/rqvae/ml1m/bridge_artifacts.pt"
train.wandb_logging=False
train.commitment_weight=0.25
train.vae_n_layers=3
train.vae_quantize_mode="ema"
train.vae_ema_decay=0.99
train.vae_dead_code_threshold=1.0
train.vae_dead_code_reset=True
train.force_dataset_process=False
train.do_eval=True
train.text_encoder_name="../models/all-MiniLM-L6-v2"
train.text_batch_size=64
train.text_encoder_device="auto"
train.text_cache_path="dataset/ml-1m/embeddings_minilm_l6.pt"
train.print_every=50
train.profile_every=50
train.train_log_every=20
train.csv_log_every=50
train.gpu_resident_sampling="auto"
train.dataloader_num_workers=0
train.torch_num_threads=8
